	cd /Users/gmlvkf282/Desktop/study/C++/cmake-build-debug && $(CMAKE_COMMAND) -P /Users/gmlvkf282/Desktop/study/C++/cmake-build-debug/CMakeFiles/VerifyGlobs.cmake
